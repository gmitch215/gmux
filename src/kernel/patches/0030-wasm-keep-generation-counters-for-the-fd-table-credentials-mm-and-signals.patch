@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The block of generation counters each task keeps (linux/wasm_gens.h): four pointers, to the counters
+ * of the fd table, credentials, memory map and signal handlers the task uses now, so tasks that share
+ * a table read the one counter. The host asks for the block's address while a task runs
+ * (wasm_current_gens), and /proc/gmux_gens shows the reader's block and values.
+ */
+
+#include <linux/fdtable.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/wasm_gens.h>
+
+u64 wasm_gen_clock;
+/* what a task without that table (a kernel thread) points at */
+static u64 no_table;
+
+void wasm_gens_refresh(struct task_struct *task)
+{
+	struct sighand_struct *sighand = rcu_access_pointer(task->sighand);
+
+	task->wasm_gens[WASM_GEN_FD] = task->files ? &task->files->wasm_gen : &no_table;
+	task->wasm_gens[WASM_GEN_CRED] = &task->wasm_cred_gen;
+	task->wasm_gens[WASM_GEN_MM] = task->mm ? &task->mm->wasm_gen : &no_table;
+	task->wasm_gens[WASM_GEN_SIG] = sighand ? &sighand->wasm_gen : &no_table;
+}
+
+__visible unsigned long wasm_current_gens(void)
+{
+	return (unsigned long)current->wasm_gens;
+}
+
+static int gens_show(struct seq_file *m, void *v)
+{
+	u64 **block = current->wasm_gens;
+	int i;
+
+	seq_printf(m, "%lx", (unsigned long)block);
+	for (i = 0; i < WASM_GENS; i++)
+		seq_printf(m, " %llu", block[i] ? *block[i] : 0);
+	seq_putc(m, '\n');
+	return 0;
+}
+
+static int __init gens_init(void)
+{
+	proc_create_single("gmux_gens", 0444, NULL, gens_show);
+	return 0;
+}
+fs_initcall(gens_init);
