--- /dev/null
+++ b/include/linux/wasm_gens.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _LINUX_WASM_GENS_H
+#define _LINUX_WASM_GENS_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+struct task_struct;
+
+#ifdef CONFIG_WASM
+/*
+ * gmux: generation counters for what a specialized path may assume about a task between two of its
+ * calls: its fd table (files_struct), credentials (the task's own), memory map (mm_struct) and signal
+ * handlers (sighand_struct). A counter moves on every change of the thing it guards and may move
+ * without one; a guard that sees the value it saw before may rely on what it saw. Every value is the
+ * next tick of one clock, so a counter never repeats a value any counter held, and a task whose
+ * table is replaced (fork, unshare, exec) reads a value it has not seen. The cpus share one host
+ * thread (patch 0001), so the clock needs no atomic. The block of four pointers in each task
+ * (task_struct.wasm_gens) names the counters the task uses, shared with the tasks that share the table
+ * (arch/wasm/mm/gens.c); its address is stable while the task lives.
+ */
+enum { WASM_GEN_FD, WASM_GEN_CRED, WASM_GEN_MM, WASM_GEN_SIG, WASM_GENS };
+
+extern u64 wasm_gen_clock;
+
+/* a new files_struct, mm_struct or sighand_struct starts at a value nothing has held */
+#define wasm_gen_init(object) ((object)->wasm_gen = ++wasm_gen_clock)
+#define wasm_gen_bump(counter) WRITE_ONCE(*(counter), ++wasm_gen_clock)
+
+/* point the task's block at the counters its tables use now */
+void wasm_gens_refresh(struct task_struct *task);
+unsigned long wasm_current_gens(void);
+#else
+#define wasm_gen_init(object) do { } while (0)
+#define wasm_gen_bump(counter) do { } while (0)
+static inline void wasm_gens_refresh(struct task_struct *task) { }
+#endif
+
+#endif /* _LINUX_WASM_GENS_H */
