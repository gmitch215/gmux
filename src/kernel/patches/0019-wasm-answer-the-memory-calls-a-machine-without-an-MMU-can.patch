From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregory Mitchell <me@gmitch215.xyz>
Date: Sat, 26 Sep 2026 13:20:00 -0400
Subject: [PATCH] wasm: answer the memory calls a machine without an MMU can

mlock, munlock, mlockall, munlockall, mlock2, mincore, msync and madvise
are MMU-only in mm/ and returned ENOSYS here. Without an MMU every page is
resident and never swapped, so locking and residency hold by
construction: the calls check their range the way their MMU versions do
and succeed. msync writes a shared file mapping back with
vfs_fsync_range(), since that mapping is the page cache itself.
MADV_DONTNEED zeroes a private anonymous range and reads a private file
range again, which is what the next fault shows on an MMU kernel;
MADV_FREE takes only private anonymous memory. KSM, huge page and
wipe-on-fork advice stay EINVAL, as on a kernel built without them.

memfd_create is built too. The defconfig asked for TMPFS, which needs
SHMEM and so an MMU, and MEMFD_CREATE came only with TMPFS; on its own it
backs a memfd with the ramfs-based shmem a no-MMU kernel has. That path
had never created an empty file: ramfs_nommu_expand_for_mapping() took
get_order(0), which is not 0, and every memfd_create failed with EFBIG.
An empty file needs no pages.
---
diff --git a/fs/ramfs/file-nommu.c b/fs/ramfs/file-nommu.c
--- a/fs/ramfs/file-nommu.c
+++ b/fs/ramfs/file-nommu.c
@@ -69,6 +69,10 @@ int ramfs_nommu_expand_for_mapping(struct inode *inode, size_t newsize)
 	gfp_t gfp = mapping_gfp_mask(inode->i_mapping);

 	/* make various checks */
+	/* an empty file, as memfd_create makes one, needs no pages; get_order(0) is not 0 */
+	if (!newsize)
+		return 0;
+
 	order = get_order(newsize);
 	if (unlikely(order > MAX_PAGE_ORDER))
 		return -EFBIG;
diff --git a/arch/wasm/configs/wasm32_nommu_defconfig b/arch/wasm/configs/wasm32_nommu_defconfig
--- a/arch/wasm/configs/wasm32_nommu_defconfig
+++ b/arch/wasm/configs/wasm32_nommu_defconfig
@@ -3,6 +3,7 @@
 CONFIG_BLK_DEV_INITRD=y
 CONFIG_EXPERT=y
 # CONFIG_IO_URING is not set
 # CONFIG_CACHESTAT_SYSCALL is not set
+CONFIG_MEMFD_CREATE=y
 # CONFIG_KALLSYMS is not set
 CONFIG_HVC_WASM=y
 # CONFIG_COMPAT_32BIT_TIME is not set
diff --git a/arch/wasm/mm/Makefile b/arch/wasm/mm/Makefile
--- a/arch/wasm/mm/Makefile
+++ b/arch/wasm/mm/Makefile
@@ -1,3 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
-obj-y += init.o owner.o private.o
+obj-y += init.o owner.o private.o advice.o
diff --git a/arch/wasm/mm/advice.c b/arch/wasm/mm/advice.c
new file mode 100644
--- /dev/null
+++ b/arch/wasm/mm/advice.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Memory calls a machine without an MMU can answer truthfully. Every page of every mapping is
+ * resident and never swapped, so mlock and mincore only check their range; shared file mappings are
+ * the page cache itself, so msync only writes it back; MADV_DONTNEED zeroes a private anonymous
+ * range, or reads a private file range again, as an MMU kernel's next fault would.
+ */
+
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/slab.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+
+/* 0 when [start, end) lies wholly inside mappings, as the callers' MMU versions require */
+static int mapped(struct mm_struct *mm, unsigned long start, unsigned long end)
+{
+	while (start < end) {
+		struct vm_area_struct *vma = find_vma(mm, start);
+
+		if (!vma || vma->vm_start > start)
+			return -ENOMEM;
+		start = vma->vm_end;
+	}
+	return 0;
+}
+
+static int check(unsigned long start, unsigned long end)
+{
+	struct mm_struct *mm = current->mm;
+	int ret;
+
+	if (end < start)
+		return -ENOMEM;
+	mmap_read_lock(mm);
+	ret = mapped(mm, start, end);
+	mmap_read_unlock(mm);
+	return ret;
+}
+
+/*
+ * mlock rounds its range out to pages instead of refusing an unaligned start. Nothing is charged to
+ * RLIMIT_MEMLOCK, since locking holds no memory that is not already held
+ */
+static int lock_range(unsigned long start, size_t len)
+{
+	unsigned long end;
+
+	len = PAGE_ALIGN(len + offset_in_page(start));
+	start &= PAGE_MASK;
+	end = start + len;
+	if (end < start)
+		return -EINVAL;
+	return end == start ? 0 : check(start, end);
+}
+
+SYSCALL_DEFINE2(mlock, unsigned long, start, size_t, len)
+{
+	return lock_range(start, len);
+}
+
+SYSCALL_DEFINE3(mlock2, unsigned long, start, size_t, len, int, flags)
+{
+	if (flags & ~MLOCK_ONFAULT)
+		return -EINVAL;
+	return lock_range(start, len);
+}
+
+SYSCALL_DEFINE2(munlock, unsigned long, start, size_t, len)
+{
+	return lock_range(start, len);
+}
+
+SYSCALL_DEFINE1(mlockall, int, flags)
+{
+	if (!flags || (flags & ~(MCL_CURRENT | MCL_FUTURE | MCL_ONFAULT)) || flags == MCL_ONFAULT)
+		return -EINVAL;
+	return 0;
+}
+
+SYSCALL_DEFINE0(munlockall)
+{
+	return 0;
+}
+
+SYSCALL_DEFINE3(mincore, unsigned long, start, size_t, len, unsigned char __user *, vec)
+{
+	static const unsigned char resident[64] = { [0 ... 63] = 1 };
+	unsigned long pages = (len >> PAGE_SHIFT) + !!offset_in_page(len);
+	int ret;
+
+	if (offset_in_page(start))
+		return -EINVAL;
+	if (!pages)
+		return 0;
+	ret = check(start, start + (pages << PAGE_SHIFT));
+	while (!ret && pages) {
+		unsigned long n = min(pages, (unsigned long)sizeof(resident));
+
+		if (copy_to_user(vec, resident, n))
+			return -EFAULT;
+		vec += n;
+		pages -= n;
+	}
+	return ret;
+}
+
+SYSCALL_DEFINE3(msync, unsigned long, start, size_t, len, int, flags)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long end = start + PAGE_ALIGN(len);
+	int ret;
+
+	if ((flags & ~(MS_ASYNC | MS_INVALIDATE | MS_SYNC)) || offset_in_page(start))
+		return -EINVAL;
+	if ((flags & MS_ASYNC) && (flags & MS_SYNC))
+		return -EINVAL;
+	if (end < start)
+		return -ENOMEM;
+	mmap_read_lock(mm);
+	ret = mapped(mm, start, end);
+	while (!ret && (flags & MS_SYNC) && start < end) {
+		struct vm_area_struct *vma = find_vma(mm, start);
+		unsigned long to = min(end, vma->vm_end);
+		struct file *file = vma->vm_file;
+
+		if (file && (vma->vm_flags & VM_SHARED)) {
+			loff_t pos = ((loff_t)vma->vm_pgoff << PAGE_SHIFT) + (start - vma->vm_start);
+
+			get_file(file);
+			mmap_read_unlock(mm);
+			ret = vfs_fsync_range(file, pos, pos + (to - start) - 1, 1);
+			fput(file);
+			mmap_read_lock(mm);
+		}
+		start = to;
+	}
+	mmap_read_unlock(mm);
+	return ret;
+}
+
+/* what an MMU kernel's next fault after MADV_DONTNEED would show in [start, end) */
+static int dontneed(struct vm_area_struct *vma, unsigned long start, unsigned long end)
+{
+	struct file *file = vma->vm_file;
+	loff_t pos;
+	void *page;
+	int ret = 0;
+
+	/* shared data stays in the page cache, as it does with an MMU */
+	if (vma->vm_flags & VM_SHARED)
+		return 0;
+	if (!file)
+		return clear_user((void __user *)start, end - start) ? -EFAULT : 0;
+	page = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!page)
+		return -ENOMEM;
+	pos = ((loff_t)vma->vm_pgoff << PAGE_SHIFT) + (start - vma->vm_start);
+	for (; start < end && !ret; start += PAGE_SIZE) {
+		ssize_t n = kernel_read(file, page, PAGE_SIZE, &pos);
+
+		if (n < 0) {
+			ret = n;
+			break;
+		}
+		memset(page + n, 0, PAGE_SIZE - n);
+		if (copy_to_user((void __user *)start, page, PAGE_SIZE))
+			ret = -EFAULT;
+	}
+	kfree(page);
+	return ret;
+}
+
+SYSCALL_DEFINE3(madvise, unsigned long, start, size_t, len, int, behavior)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long end = start + PAGE_ALIGN(len);
+	int ret;
+
+	/* KSM, transparent huge pages and wipe-on-fork are not built, as on a kernel without them */
+	switch (behavior) {
+	case MADV_NORMAL:
+	case MADV_RANDOM:
+	case MADV_SEQUENTIAL:
+	case MADV_WILLNEED:
+	case MADV_DONTNEED:
+	case MADV_FREE:
+	case MADV_DONTFORK:
+	case MADV_DOFORK:
+	case MADV_DONTDUMP:
+	case MADV_DODUMP:
+	case MADV_COLD:
+	case MADV_PAGEOUT:
+	case MADV_POPULATE_READ:
+	case MADV_POPULATE_WRITE:
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (offset_in_page(start) || end < start || (len && end == start))
+		return -EINVAL;
+	mmap_read_lock(mm);
+	ret = mapped(mm, start, end);
+	while (!ret && (behavior == MADV_DONTNEED || behavior == MADV_FREE) && start < end) {
+		struct vm_area_struct *vma = find_vma(mm, start);
+		unsigned long to = min(end, vma->vm_end);
+
+		/* MADV_FREE may keep the data; it takes only private anonymous memory */
+		if (behavior == MADV_FREE)
+			ret = vma->vm_file || (vma->vm_flags & VM_SHARED) ? -EINVAL : 0;
+		else
+			ret = dontneed(vma, start, to);
+		start = to;
+	}
+	mmap_read_unlock(mm);
+	return ret;
+}
