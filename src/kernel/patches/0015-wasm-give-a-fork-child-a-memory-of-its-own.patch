From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregory Mitchell <me@gmitch215.xyz>
Date: Sat, 26 Sep 2026 09:40:00 -0400
Subject: [PATCH] wasm: give a fork child a memory of its own

nommu's dup_mmap gives a fork child an empty mm, and every process lives
in the kernel's memory, so a child at its parent's addresses would write
its parent's bytes. On wasm a fork child's mm now mirrors the parent's
mappings at the same addresses (sharing their regions, marked shared so
nothing splits them), and the child's bytes live in a WebAssembly memory
of its own that the host keeps: wasm_user_mapped copies each mapping's
bytes into it as the child gets the mapping (the parent's at fork, a new
mapping's initial bytes after), and wasm_user_forget drops it with the mm.

For such an mm the uaccess routines and the futex atomics go through the
host (wasm_user_copy, wasm_user_atomic) instead of memcpy and native
atomics, so UACCESS_MEMCPY is no longer selected. The page owner table
leaves a fork child's mappings alone, since its bytes are not at those
pages. wasm_current_mm tells the host which memory a task runs on.
---
--- a/mm/nommu.c
+++ b/mm/nommu.c
@@ -1211,6 +1211,10 @@
 	current->mm->map_count++;
 	/* add the VMA to the tree */
 	vma_iter_store_new(&vmi, vma);
+#ifdef CONFIG_WASM
+	if (current->mm->context.private_memory)
+		wasm_user_mapped(current->mm, vma->vm_start, vma->vm_end);
+#endif
 
 	/* we flush the region from the icache only when the first executable
 	 * mapping of it is made  */
@@ -1592,6 +1596,8 @@
 	vma->vm_end = vma->vm_start + new_len;
 #ifdef CONFIG_WASM
 	wasm_owner_map(vma);
+	if (vma->vm_mm->context.private_memory)
+		wasm_user_mapped(vma->vm_mm, vma->vm_start, vma->vm_end);
 #endif
 	return vma->vm_start;
 }
@@ -1915,10 +1921,63 @@
 }
 subsys_initcall(init_admin_reserve);
 
+#ifdef CONFIG_WASM
+/*
+ * A fork child's mm on wasm: the parent's mappings at the same addresses, each sharing the parent's
+ * region, while the child's bytes live in a memory of its own that the host fills from the parent's
+ * as each mapping is added (wasm_user_mapped). The mirrored mappings count as shared, so a partial
+ * munmap or an mremap of one is refused rather than splitting a region both mms use.
+ */
+static int wasm_mirror_mm(struct mm_struct *mm, struct mm_struct *oldmm)
+{
+	struct vm_area_struct *vma, *new;
+	VMA_ITERATOR(old_vmi, oldmm, 0);
+	int ret = 0;
+
+	mm->context.private_memory = 1;
+	mm->context.owner = 0;
+	mmap_write_lock_nested(mm, SINGLE_DEPTH_NESTING);
+	for_each_vma(old_vmi, vma) {
+		VMA_ITERATOR(vmi, mm, vma->vm_start);
+
+		new = vm_area_dup(vma);
+		if (!new) {
+			ret = -ENOMEM;
+			break;
+		}
+		vm_flags_set(new, VM_MAYSHARE);
+		vma_iter_config(&vmi, new->vm_start, new->vm_end);
+		if (vma_iter_prealloc(&vmi, new)) {
+			vm_area_free(new);
+			ret = -ENOMEM;
+			break;
+		}
+		down_write(&nommu_region_sem);
+		new->vm_region->vm_usage++;
+		up_write(&nommu_region_sem);
+		if (new->vm_file)
+			get_file(new->vm_file);
+		if (new->vm_ops && new->vm_ops->open)
+			new->vm_ops->open(new);
+		setup_vma_to_mm(new, mm);
+		mm->map_count++;
+		vma_iter_store_new(&vmi, new);
+		wasm_user_mapped(mm, new->vm_start, new->vm_end);
+	}
+	mmap_write_unlock(mm);
+	return ret;
+}
+#endif
+
 int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
+	int ret = 0;
+
 	mmap_write_lock(oldmm);
 	dup_mm_exe_file(mm, oldmm);
+#ifdef CONFIG_WASM
+	ret = wasm_mirror_mm(mm, oldmm);
+#endif
 	mmap_write_unlock(oldmm);
-	return 0;
+	return ret;
 }
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -20,7 +20,6 @@
 
 	select THREAD_INFO_IN_TASK
 	select GENERIC_SMP_IDLE_THREAD
-	select UACCESS_MEMCPY
 	select ARCH_USE_QUEUED_RWLOCKS
 	select GENERIC_CPU_DEVICES
 	select GENERIC_CSUM
--- a/arch/wasm/include/asm/mmu.h
+++ b/arch/wasm/include/asm/mmu.h
@@ -7,6 +7,8 @@
 typedef struct {
 	unsigned long end_brk;
 	unsigned int owner;
+	/* a fork child's: its bytes are in a memory of its own, reached through the host */
+	unsigned int private_memory;
 } mm_context_t;
 
 #endif /* _ASM_WASM_MMU_H */
--- a/arch/wasm/include/asm/uaccess.h
+++ b/arch/wasm/include/asm/uaccess.h
@@ -14,6 +14,60 @@
 #define user_read_access_begin(ptr, len) access_ok(ptr, 1)
 #define user_read_access_end() do { } while (0)
 
+/*
+ * User memory is the kernel's memory, except a fork child's, which is in a memory of its own; the
+ * host copies to and from it (wasm_user_copy: to_user 1, from 0, zeroing 2) and says how many bytes
+ * it could not reach.
+ */
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+int wasm_user_private(void);
+unsigned long wasm_user_copy(void *kaddr, unsigned long uaddr, unsigned long n, int to_user);
+
+static inline __must_check unsigned long
+raw_copy_from_user(void *to, const void __user *from, unsigned long n)
+{
+	if (unlikely(wasm_user_private()))
+		return wasm_user_copy(to, (unsigned long)from, n, 0);
+	memcpy(to, (const void __force *)from, n);
+	return 0;
+}
+
+static inline __must_check unsigned long
+raw_copy_to_user(void __user *to, const void *from, unsigned long n)
+{
+	if (unlikely(wasm_user_private()))
+		return wasm_user_copy((void *)from, (unsigned long)to, n, 1);
+	memcpy((void __force *)to, from, n);
+	return 0;
+}
+#define INLINE_COPY_FROM_USER
+#define INLINE_COPY_TO_USER
+
+#define __clear_user __clear_user
+static inline __must_check unsigned long __clear_user(void __user *to, unsigned long n)
+{
+	if (unlikely(wasm_user_private()))
+		return wasm_user_copy(NULL, (unsigned long)to, n, 2);
+	memset((void __force *)to, 0, n);
+	return 0;
+}
+
+#define __get_kernel_nofault(dst, src, type, err_label)			\
+do {									\
+	*((type *)dst) = get_unaligned((type *)(src));			\
+	if (0) /* make sure the label looks used to the compiler */	\
+		goto err_label;						\
+} while (0)
+
+#define __put_kernel_nofault(dst, src, type, err_label)			\
+do {									\
+	put_unaligned(*((type *)src), (type *)(dst));			\
+	if (0) /* make sure the label looks used to the compiler */	\
+		goto err_label;						\
+} while (0)
+
 #include <asm-generic/uaccess.h>
 
 #endif /* _ASM_WASM_UACCESS_H */
--- a/arch/wasm/include/asm/futex.h
+++ b/arch/wasm/include/asm/futex.h
@@ -9,6 +9,10 @@
 
 #define FUTEX_MAX_LOOPS	128
 
+/* a fork child's futexes are in its own memory: the host does the atomic there (op 5: cmpxchg) */
+int wasm_user_private(void);
+int wasm_user_atomic(int op, unsigned long uaddr, u32 arg, u32 arg2, u32 *old);
+
 static inline int futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
 						u32 oldval, u32 newval)
 {
@@ -17,6 +21,8 @@
 
 	if (!access_ok(uaddr, sizeof(u32)))
 		return -EFAULT;
+	if (wasm_user_private())
+		return wasm_user_atomic(5, (unsigned long)uaddr, oldval, newval, uval);
 
 	for (loops = 0; loops < FUTEX_MAX_LOOPS; ++loops) {
 		expected = oldval;
@@ -36,6 +42,9 @@
 {
 	if (!access_ok(uaddr, sizeof(u32)))
 		return -EFAULT;
+	if (wasm_user_private())
+		return op >= FUTEX_OP_SET && op <= FUTEX_OP_XOR
+			? wasm_user_atomic(op, (unsigned long)uaddr, oparg, 0, (u32 *)oval) : -ENOSYS;
 
 	switch (op) {
 	case FUTEX_OP_SET:
--- a/arch/wasm/include/asm/wasm.h
+++ b/arch/wasm/include/asm/wasm.h
@@ -44,6 +44,12 @@
 unsigned long wasm_owner_table(void);
 unsigned int wasm_current_owner(void);
 unsigned int wasm_current_euid(void);
+unsigned long wasm_current_mm(void);
+
+/* gmux: a fork child's own memory (arch/wasm/mm/private.c): the host fills and forgets it */
+struct mm_struct;
+extern void wasm_user_mapped(struct mm_struct *mm, unsigned long start, unsigned long end);
+extern void wasm_user_forget(struct mm_struct *mm);
 
 /* gmux: the page owner table (arch/wasm/mm/owner.c) */
 struct vm_area_struct;
--- a/arch/wasm/mm/owner.c
+++ b/arch/wasm/mm/owner.c
@@ -64,6 +64,9 @@
 {
 	u16 tag;
 
+	/* a fork child's bytes are not at these pages: they stay the parent's */
+	if (vma->vm_mm->context.private_memory)
+		return;
 	if (is_nommu_shared_mapping(vma->vm_flags))
 		tag = vma->vm_flags & VM_WRITE ? WASM_OWNER_SHARED : WASM_OWNER_SHARED_RO;
 	else
@@ -73,6 +76,8 @@
 
 void wasm_owner_unmap(struct vm_area_struct *vma, unsigned long start, unsigned long end)
 {
+	if (vma->vm_mm->context.private_memory)
+		return;
 	/* pages other mappings still share keep their tag */
 	if (is_nommu_shared_mapping(vma->vm_flags) && vma->vm_region && vma->vm_region->vm_usage > 1)
 		return;
@@ -81,6 +86,8 @@
 
 void wasm_owner_release(struct mm_struct *mm)
 {
+	if (mm->context.private_memory)
+		wasm_user_forget(mm);
 	if (mm->context.owner)
 		ida_free(&owner_ida, mm->context.owner);
 	mm->context.owner = 0;
@@ -93,6 +100,9 @@
 
 	if (!size || !owners || !current->mm || uid_eq(current_euid(), GLOBAL_ROOT_UID))
 		return 1;
+	/* a fork child reaches only its own memory, through the host */
+	if (current->mm->context.private_memory)
+		return 1;
 	if (addr + size < addr)
 		return 0;
 	mine = READ_ONCE(current->mm->context.owner);
--- a/arch/wasm/mm/Makefile
+++ b/arch/wasm/mm/Makefile
@@ -1,3 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
-obj-y += init.o owner.o
+obj-y += init.o owner.o private.o
--- /dev/null
+++ b/arch/wasm/mm/private.c
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A fork child's memory: nommu gives every process the kernel's memory, and a fork child the same
+ * addresses as its parent, so on wasm its bytes live in a memory of its own that the host keeps. The
+ * uaccess routines (asm/uaccess.h) and futex atomics go through the host for such an mm.
+ */
+
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <asm/wasm.h>
+
+int wasm_user_private(void)
+{
+	struct mm_struct *mm = current->mm;
+
+	return mm && mm->context.private_memory;
+}
+EXPORT_SYMBOL(wasm_user_private);
+
+/* for the host, which picks the memory a task's program runs on */
+__visible unsigned long wasm_current_mm(void)
+{
+	return (unsigned long)current->mm;
+}
