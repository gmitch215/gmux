From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregory Mitchell <me@gmitch215.xyz>
Date: Fri, 25 Sep 2026 18:40:00 -0400
Subject: [PATCH] wasm: call every syscall at its own arity

The dispatch cast each handler to the number of arguments userspace
passed, and wasm's call_indirect traps when the two differ: musl's pause()
is ppoll with 4 of its 5 arguments, and a program that paused died in
__wasm_syscall_4. syscall_adapters.c, generated by gmux's
scripts/kernel/syscall-adapters.py from the preprocessed syscall table,
reads each handler's built wasm type from a first build (SYSCALL_DEFINE
leaves only __se_sys_x in wasm; unbuilt syscalls are sys_ni_syscall;
wasm32's rt_sigreturn takes no arguments) and calls the table entry at
exactly that type from the six argument slots, zeroed past the ones
passed, joining two slots for an i64 parameter. Regenerate after a config
change until scripts/kernel/adapters-check.sh reports a fixed point. It
also fixed futex's arity, which kept pthread_join from ever waking.
---
diff --git a/arch/wasm/kernel/syscall_adapters.c b/arch/wasm/kernel/syscall_adapters.c
new file mode 100644
--- /dev/null
+++ b/arch/wasm/kernel/syscall_adapters.c
@@ -0,0 +1,362 @@
+// generated by gmux scripts/kernel/syscall-adapters.py from the syscall table and a built
+// vmlinux; do not edit
+#include <asm/syscall.h>
+
+#define WASM_J64(i) (((unsigned long long)(unsigned long)a[(i) + 1] << 32) | (unsigned long)a[i])
+
+static long wasm_call_v(void (*f)(void), const long *a)
+{
+	return ((long (*)(void))(void *)f)();
+}
+
+static long wasm_call_i(void (*f)(void), const long *a)
+{
+	return ((long (*)(long))(void *)f)(a[0]);
+}
+
+static long wasm_call_iii(void (*f)(void), const long *a)
+{
+	return ((long (*)(long, long, long))(void *)f)(a[0], a[1], a[2]);
+}
+
+static long wasm_call_iiiii(void (*f)(void), const long *a)
+{
+	return ((long (*)(long, long, long, long, long))(void *)f)(a[0], a[1], a[2], a[3], a[4]);
+}
+
+static long wasm_call_iiii(void (*f)(void), const long *a)
+{
+	return ((long (*)(long, long, long, long))(void *)f)(a[0], a[1], a[2], a[3]);
+}
+
+static long wasm_call_ii(void (*f)(void), const long *a)
+{
+	return ((long (*)(long, long))(void *)f)(a[0], a[1]);
+}
+
+static long wasm_call_iiiiii(void (*f)(void), const long *a)
+{
+	return ((long (*)(long, long, long, long, long, long))(void *)f)(a[0], a[1], a[2], a[3], a[4], a[5]);
+}
+
