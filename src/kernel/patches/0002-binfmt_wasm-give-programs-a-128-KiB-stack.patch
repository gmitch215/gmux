From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregory Mitchell <me@gmitch215.xyz>
Date: Fri, 25 Sep 2026 18:05:00 -0400
Subject: [PATCH] binfmt_wasm: give programs a 128 KiB stack and no brk

binfmt_wasm mapped two pages for a program's stack, started brk at the
bottom of the same mapping and let it grow to the top, and mallocng takes
its metadata from brk. The stack and the allocator's metadata met in the
middle: Lua aborted in free() after an error raised inside a coroutine
under pcall, and in malloc() building a long list. The stack is now 128
KiB, what binfmt_elf_fdpic gives a nommu program that does not ask for a
size, and brk has no room, so musl's malloc takes its metadata from mmap.

The arguments, environment and auxiliary vector are a mapping of their
own, so the stack is exactly 32 pages. With the arguments on top of it an
exec asked for 33 pages, which the page allocator serves from a 64-page
block and gives back the rest of; an 800-page machine had no such block
left after 104 execs. The initial stack pointer is 16 bytes below the
page-aligned top of the stack, and the word at the top holds the address
of the argument tables, which a program's _start reads in place of
assuming they sit above its stack pointer.
---
 fs/binfmt_wasm.c | 73 +++++++++++++++++++++++++++++++++---------------
 1 file changed, 50 insertions(+), 23 deletions(-)

diff --git a/fs/binfmt_wasm.c b/fs/binfmt_wasm.c
index ccc48e9d3..585de67c9 100644
--- a/fs/binfmt_wasm.c
+++ b/fs/binfmt_wasm.c
@@ -20,28 +20,38 @@
 #include <linux/uaccess.h>
 #include <linux/vmalloc.h>
 
-#define WASM_STACK_SIZE		(2UL * PAGE_SIZE)
+/*
+ * 128 KiB, the default binfmt_elf_fdpic gives nommu programs, in a mapping of its own. The
+ * mapping is 32 pages, one block from the page allocator; a 33rd page would take a 64-page block
+ * and give back the rest, and a small machine runs out of those after a hundred execs.
+ */
+#define WASM_STACK_SIZE		(128UL * 1024)
 
 /*
- * Userland expects the stack to be page aligned as of now, which allows it to
- * find the initial stack pointer by rounding up the current stack pointer to
- * the next page in the _start function. This allows _start to be written in C.
- * If this restriction can be lifted we could instead use something like this:
- * max_t(unsigned long, sizeof(void *), ARCH_SLAB_MINALIGN)
+ * The arguments, environment and auxiliary vector are in a mapping of their own. The top of the
+ * stack is page aligned and the initial stack pointer is WASM_STACK_RESERVE below it; the word at
+ * the top holds the address of the argument tables. _start finds the top by rounding up the
+ * address of one of its locals to the next page, and reads the word below it. This allows _start
+ * to be written in C.
  */
-#define WASM_STACK_ALIGN 	PAGE_SIZE
+#define WASM_STACK_RESERVE	16UL
+
+/* room for the auxiliary vector below; create_wasm_tables checks it */
+#define WASM_AUXV_SIZE		(16UL * sizeof(unsigned long))
 
 #define WASM_DYLINK_MEMINFO	(0x01)
 
 /*
  * Parse the env- and arg-strings in new user memory and create the pointer
- * tables from them, and put their addresses on the "stack", recording the new
- * stack pointer value.
+ * tables from them, and put their address on the "stack", recording the new
+ * stack pointer value. The strings are at the top of the argument mapping, copied
+ * there by transfer_args_to_stack, and the tables are below them.
  */
 static int create_wasm_tables(struct linux_binprm *bprm, unsigned long arg_start)
 {
 	char __user *p;
 	unsigned long __user *sp;
+	unsigned long stack_top = current->mm->start_brk + WASM_STACK_SIZE;
 	long i, len;
 	const struct cred *cred = current_cred();
 
@@ -57,8 +67,10 @@ static int create_wasm_tables(struct linux_binprm *bprm, unsigned long arg_start
 		AT_NULL, 0UL /* end */
 	};
 
+	BUILD_BUG_ON(sizeof(wasm_auxv) > WASM_AUXV_SIZE);
+
 	p = (char __user *)arg_start;
-	sp = (unsigned long __user *)current->mm->start_stack;
+	sp = (unsigned long __user *)(arg_start & -sizeof(unsigned long));
 
 	sp -= (sizeof(wasm_auxv) + (sizeof(unsigned long) - 1U)) /
 		sizeof(unsigned long);
@@ -66,8 +78,10 @@ static int create_wasm_tables(struct linux_binprm *bprm, unsigned long arg_start
 	sp -= bprm->argc + 1;
 	sp -= 1; /* &argc */
 
-	current->mm->start_stack = (unsigned long)sp & -WASM_STACK_ALIGN;
-	sp = (unsigned long __user *)current->mm->start_stack;
+	if (put_user((unsigned long)sp, (unsigned long __user *)
+			(stack_top - sizeof(unsigned long))))
+		return -EFAULT;
+	current->mm->start_stack = stack_top - WASM_STACK_RESERVE;
 
 	if (put_user(bprm->argc, sp++))
 		return -EFAULT;
@@ -173,7 +187,7 @@ static bool wasm_consume_varU32_user(
 static int load_wasm_file(struct linux_binprm *bprm, unsigned long extra_stack)
 {
 	unsigned long data_start = 0; /* Will contain data and bss */
-	unsigned long stack_size;
+	unsigned long args_start;
 	unsigned long whole_start, whole_p, whole_size, whole_end;
 	loff_t whole_size_ll;
 	char *parsed = bprm->buf;
@@ -355,8 +369,7 @@ static int load_wasm_file(struct linux_binprm *bprm, unsigned long extra_stack)
 	/*
 	 * Create a stack, and put the brk at the start of this area.
 	*/
-	stack_size = PAGE_ALIGN(WASM_STACK_SIZE + extra_stack);
-	current->mm->start_brk = vm_mmap(NULL, 0, stack_size,
+	current->mm->start_brk = vm_mmap(NULL, 0, WASM_STACK_SIZE,
 			PROT_READ|PROT_WRITE,
 			MAP_PRIVATE|MAP_ANONYMOUS|MAP_GROWSDOWN, 0);
 	if (!current->mm->start_brk || IS_ERR_VALUE(current->mm->start_brk)) {
@@ -368,9 +381,24 @@ static int load_wasm_file(struct linux_binprm *bprm, unsigned long extra_stack)
 	}
 	current->mm->brk = current->mm->start_brk; /* Already page aligned... */
 #ifndef CONFIG_MMU
-	current->mm->context.end_brk = current->mm->start_brk + stack_size;
+	/* no room for brk: it would grow into the stack; musl's malloc falls back to mmap */
+	current->mm->context.end_brk = current->mm->start_brk;
 #endif
-	current->mm->start_stack = current->mm->start_brk + stack_size;
+
+	/*
+	 * The arguments get a mapping of their own; start_stack is the end of it until the tables
+	 * are made.
+	 */
+	args_start = vm_mmap(NULL, 0, extra_stack, PROT_READ|PROT_WRITE,
+			MAP_PRIVATE|MAP_ANONYMOUS, 0);
+	if (!args_start || IS_ERR_VALUE(args_start)) {
+		ret = args_start ? (int)args_start : -ENOMEM;
+		pr_err("Unable to allocate RAM for arguments, errno: %d\n", ret);
+		vm_munmap(current->mm->start_brk, WASM_STACK_SIZE);
+		current->mm->start_brk = 0;
+		goto out_unmap;
+	}
+	current->mm->start_stack = args_start + extra_stack;
 
 	/* Only set these if the above succeeds. */
 	current->mm->start_code = whole_start;
@@ -401,18 +429,17 @@ static int load_wasm_binary(struct linux_binprm *bprm)
 	int res;
 
 	/*
-	 * We have to add the size of our arguments to our stack size
-	 * otherwise it's too easy for users to create stack overflows
-	 * by passing in a huge argument list.  And yes,  we have to be
-	 * pedantic and include space for the argv/envp array as it may have
-	 * a lot of entries.
+	 * The arguments get a mapping of their own, as large as the strings,
+	 * the argv/envp arrays, argc and the auxiliary vector, and the word
+	 * the strings' end is aligned down by.
 	 */
 #ifndef CONFIG_MMU
 	extra_stack += PAGE_SIZE * MAX_ARG_PAGES - bprm->p; /* the strings */
 #endif
 	extra_stack += (bprm->argc + 1) * sizeof(char *);   /* the argv array */
 	extra_stack += (bprm->envc + 1) * sizeof(char *);   /* the envp array */
-	extra_stack = ALIGN(extra_stack, WASM_STACK_ALIGN);
+	extra_stack += WASM_AUXV_SIZE + 2 * sizeof(unsigned long);
+	extra_stack = PAGE_ALIGN(extra_stack);
 
 	res = load_wasm_file(bprm, extra_stack);
 	if (res < 0)
-- 
2.43.0

