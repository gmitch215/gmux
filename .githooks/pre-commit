#!/usr/bin/env bash
# Pre-commit hook: clang-format for C/C++, prettier for everything else.
# Reformatted files are re-added to the index. Fails the commit if a formatter is
# missing or if reformatting fails.

set -euo pipefail

staged() {
	git diff --cached --name-only --diff-filter=ACMRT | grep -E "$1" || true
}

fail=0

# C and C++
c_files=()
while IFS= read -r file; do
	c_files+=("$file")
done < <(staged '\.(c|cpp|h|hpp)$')

if [[ ${#c_files[@]} -gt 0 ]]; then
	if ! command -v clang-format > /dev/null 2>&1; then
		echo "[pre-commit] Error: clang-format not found in PATH" >&2
		exit 1
	fi

	echo "[pre-commit] Running clang-format on ${#c_files[@]} file(s)..."
	for f in "${c_files[@]}"; do
		[[ -f $f ]] || continue
		if ! clang-format -i "$f" --style=file; then
			echo "[pre-commit] Failed to format $f" >&2
			fail=1
		else
			git add "$f"
			echo "[pre-commit] Formatted $f"
		fi
	done
fi

# TypeScript, JSON, YAML, Markdown, shell
other_files=()
while IFS= read -r file; do
	other_files+=("$file")
done < <(staged '\.(ts|js|mjs|cjs|json|jsonc|yml|yaml|md|sh)$')

if [[ ${#other_files[@]} -gt 0 ]]; then
	# prettier is a dev dependency, so a checkout with no node_modules skips rather than blocks
	if [[ -x node_modules/.bin/prettier ]]; then
		echo "[pre-commit] Running prettier on ${#other_files[@]} file(s)..."
		for f in "${other_files[@]}"; do
			[[ -f $f ]] || continue
			if ! node_modules/.bin/prettier --write --ignore-unknown "$f" > /dev/null; then
				echo "[pre-commit] Failed to format $f" >&2
				fail=1
			else
				git add "$f"
				echo "[pre-commit] Formatted $f"
			fi
		done
	else
		echo "[pre-commit] prettier not installed, skipping ${#other_files[@]} file(s)" >&2
	fi
fi

if [[ $fail -ne 0 ]]; then
	echo "[pre-commit] One or more files failed to format." >&2
	exit $fail
fi

exit 0
