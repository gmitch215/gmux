{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts"],
	"out": "build-typedoc",
	"name": "gmux",
	"readme": "./README.md",
	"customCss": "./docs/typedoc.css",
	"favicon": "./assets/gmux.ico",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}
