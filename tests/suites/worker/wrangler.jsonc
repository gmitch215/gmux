{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "gmux-suite",
	"main": "worker.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"assets": {
		"directory": "../../../build/suite/assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"durable_objects": { "bindings": [{ "name": "MACHINE", "class_name": "SuiteMachine" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SuiteMachine"] }]
}
