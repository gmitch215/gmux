(module
	(memory (export "memory") 520)
	(global $mask (export "mask") (mut i32) (i32.const 0x1fffffc))
	;; region 0..32 MiB is the heap; 32 MiB.. holds the page bitmap (512 bytes) and the card table (64 KiB)
	(func $step (param $x i32) (result i32)
		(i32.and (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)) (global.get $mask)))
	(func (export "plain") (param $n i32) (result i32)
		(local $i i32) (local $a i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $a (call $step (i32.add (local.get $a) (local.get $i))))
			(i32.store (local.get $a) (local.get $i))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $a))
	(func (export "barrier") (param $n i32) (result i32)
		(local $i i32) (local $a i32) (local $p i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $a (call $step (i32.add (local.get $a) (local.get $i))))
			;; first write to a 64 KiB page since the epoch marks it
			(local.set $p (i32.add (i32.const 0x2000000) (i32.shr_u (local.get $a) (i32.const 16))))
			(if (i32.eqz (i32.load8_u (local.get $p)))
				(then (i32.store8 (local.get $p) (i32.const 1))))
			(i32.store (local.get $a) (local.get $i))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $a))
	(func (export "card") (param $n i32) (result i32)
		(local $i i32) (local $a i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $a (call $step (i32.add (local.get $a) (local.get $i))))
			;; unconditional mark of a 512-byte card
			(i32.store8 (i32.add (i32.const 0x2001000) (i32.shr_u (local.get $a) (i32.const 9))) (i32.const 1))
			(i32.store (local.get $a) (local.get $i))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $a)))
