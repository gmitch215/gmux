{
	"name": "gmux-tau",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-20",
	"workers_dev": true,
	"durable_objects": { "bindings": [{ "name": "RIG", "class_name": "Rig" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rig"] }],
	"rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }]
}
