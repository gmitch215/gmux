{
	"name": "gmux-write-back",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"durable_objects": {
		"bindings": [{ "name": "MACHINE", "class_name": "MachineDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineDO"] }],
	"rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }]
}
