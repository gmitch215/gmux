{
	"name": "gmux-socket",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"workers_dev": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "SOCKET",
				"class_name": "SocketDO"
			},
			{
				"name": "CLIENT",
				"class_name": "ClientDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SocketDO", "ClientDO"]
		}
	]
}
