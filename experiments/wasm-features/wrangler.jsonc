{
	"name": "gmux-wasm-features",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"durable_objects": {
		"bindings": [{ "name": "PROBE", "class_name": "ProbeDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeDO"] }],
	"rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }]
}
