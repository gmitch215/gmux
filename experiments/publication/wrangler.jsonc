{
	"name": "gmux-publication",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PROBE",
				"class_name": "Probe"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Probe"]
		}
	]
}
