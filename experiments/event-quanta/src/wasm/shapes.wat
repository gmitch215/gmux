(module
	(memory (export "memory") 520)
	(func (export "alu") (param $n i32) (result i32)
		(local $i i32) (local $x i32)
		(local.set $x (i32.const 1))
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 13))))
			(local.set $x (i32.xor (local.get $x) (i32.shr_u (local.get $x) (i32.const 17))))
			(local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 5))))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $x))
	(func (export "branchy") (param $n i32) (result i32)
		(local $i i32) (local $x i32) (local $c i32)
		(local.set $x (i32.const 7))
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)))
			(if (i32.and (i32.shr_u (local.get $x) (i32.const 16)) (i32.const 1))
				(then (local.set $c (i32.add (local.get $c) (i32.const 3))))
				(else (local.set $c (i32.sub (local.get $c) (i32.const 1)))))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $c))
	;; a single-cycle permutation over 32 MiB so every load misses
	(func (export "chase_init") (param $slots i32)
		(local $i i32) (local $j i32) (local $t i32) (local $x i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $slots)))
			(i32.store (i32.shl (local.get $i) (i32.const 2)) (local.get $i))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.set $x (i32.const 12345))
		(local.set $i (i32.sub (local.get $slots) (i32.const 1)))
		(block $d2 (loop $l2
			(br_if $d2 (i32.eqz (local.get $i)))
			(local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)))
			(local.set $j (i32.rem_u (i32.shr_u (local.get $x) (i32.const 1)) (local.get $i)))
			(local.set $t (i32.load (i32.shl (local.get $i) (i32.const 2))))
			(i32.store (i32.shl (local.get $i) (i32.const 2)) (i32.load (i32.shl (local.get $j) (i32.const 2))))
			(i32.store (i32.shl (local.get $j) (i32.const 2)) (local.get $t))
			(local.set $i (i32.sub (local.get $i) (i32.const 1)))
			(br $l2))))
	(func (export "chase") (param $n i32) (result i32)
		(local $i i32) (local $p i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $p (i32.load (i32.shl (local.get $p) (i32.const 2))))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $p))
	(func $leaf (param $a i32) (param $b i32) (result i32)
		(i32.add (i32.mul (local.get $a) (i32.const 31)) (local.get $b)))
	(func (export "calls") (param $n i32) (result i32)
		(local $i i32) (local $x i32)
		(block $d (loop $l
			(br_if $d (i32.ge_u (local.get $i) (local.get $n)))
			(local.set $x (call $leaf (local.get $x) (local.get $i)))
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $l)))
		(local.get $x)))
